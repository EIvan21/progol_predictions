[Unit]
Description=Progol Telegram Bot (long-polling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=progol-bot
WorkingDirectory=/opt/progol_predictions
EnvironmentFile=/opt/progol_predictions/.env
ExecStart=/opt/progol_predictions/venv/bin/python -m src.progol.bot.app
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
